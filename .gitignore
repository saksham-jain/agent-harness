qdrant_storage
__pycache__/
.venv/
venv/
*.pyc
.DS_Store

# Real bearer tokens. Only tokens.example.json is committed.
tokens.json

# Local overrides. Holds MCP_AUTH, and in production would hold secrets.
.env

# TLS material. Contains a private key — never commit.
.certs/
*.pem
*.key

# Real documents. The index is derived from these, and pruning treats this directory as the
# source of truth — a document deleted here is deleted from the index — which makes these
# files the only copy. Keeping them out of git is the point: a lease or a passport scan must
# never reach history, and .gitignore is the only thing that stops it.
#
# docs.sample/ is committed and is what the evals index. Point DOCS_DIR at docs.sample to
# run them, or at docs for your own corpus.
docs/
